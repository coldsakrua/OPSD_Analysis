X = int(input())
frequency = {}

for i in range(1, 10):
    for j in range(1, 10):
        product = i * j
        if product == X:
            frequency[X] += 1
        else:
            frequency[product] = frequency.get(product, 0) + 1

total = 2025
result = total - X * frequency.get(X, 0)
print(result)
