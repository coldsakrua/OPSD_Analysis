def is_not_prime(n):
    """
    Determine if a number is not prime.
    Returns True if the number is not prime, False otherwise.
    """
    if n <= 1:
        return True
    if n == 2:
        return False
    for i in range(3, int(n**0.5) + 1, 2):
        if n % i == 0:
            return True
    return False

# Test cases
assert is_not_prime(2) == False
