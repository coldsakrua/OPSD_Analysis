import sys

def main():
    data = sys.stdin.read().strip().split()
    if not data:
        return
    X = int(data[0])

    # Total sum of all entries in a 9x9 multiplication table:
    # sum_{i=1..9} sum_{j=1..9} i*j = (1+2+...+9)^2 = 45^2 = 2025

...
f X % i == 0:
            j = X // i
            if 1 <= j <= 9:
                count_X += 1

    # Subtract the contribution of all X's from the total sum
    answer = total_sum - X * count_X
    print(answer)

if __name__ == "__main__":
    main()
